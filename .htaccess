# CERTIVIO – Apache (WebSupport a pod.)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS (odkomentujte po aktivácii SSL certifikátu)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /sluzby/byt -> sluzba.php?s=byt
  RewriteRule ^sluzby/([a-z0-9-]+)/?$ sluzba.php?s=$1 [L,QSA]

  RewriteRule ^sitemap.xml$ sitemap.php [L]

  # /index.php -> /
  RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
  RewriteRule ^index\.php$ ./ [R=301,L]

  # Odstránenie .php z URL:  /cennik -> cennik.php
  RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.php[\s?] [NC]
  RewriteCond %1 !^(send|404|sluzba)$ [NC]
  RewriteRule ^([a-z0-9-]+)\.php$ $1 [R=301,L]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]
</IfModule>

# Ochrana interných súborov
<FilesMatch "^(config|header|footer|logo|class-picker)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
RedirectMatch 403 ^/includes/

# Kompresia a cache
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

# Bezpečnostné hlavičky
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
